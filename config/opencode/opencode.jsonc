{
    "$schema": "https://opencode.ai/config.json",
    "update": "disable",
    "permissions": [
        { "action": "shell", "resource": "*", "effect": "allow" },

        { "action": "shell", "resource": "rm -rf /*", "effect": "deny" },
        { "action": "shell", "resource": "rm -rf /", "effect": "deny" },
        { "action": "shell", "resource": "rm -rf ~*", "effect": "deny" },
        { "action": "shell", "resource": "rm -rf $HOME*", "effect": "deny" },
        { "action": "shell", "resource": "rm -rf .", "effect": "deny" },
        { "action": "shell", "resource": "rm -rf ..", "effect": "deny" },
        { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
        { "action": "shell", "resource": "rm -fr *", "effect": "ask" },
        { "action": "shell", "resource": "rm -r *", "effect": "ask" },
        { "action": "shell", "resource": "rmdir *", "effect": "ask" },
        { "action": "shell", "resource": "shred *", "effect": "deny" },
        { "action": "shell", "resource": "unlink *", "effect": "ask" },
        { "action": "shell", "resource": "find * -delete*", "effect": "ask" },
        { "action": "shell", "resource": "find * -exec rm*", "effect": "ask" },

        { "action": "shell", "resource": "sudo *", "effect": "ask" },
        { "action": "shell", "resource": "su *", "effect": "deny" },
        { "action": "shell", "resource": "doas *", "effect": "ask" },
        { "action": "shell", "resource": "pkexec *", "effect": "deny" },
        { "action": "shell", "resource": "chmod -R *", "effect": "ask" },
        { "action": "shell", "resource": "chmod 777 *", "effect": "deny" },
        { "action": "shell", "resource": "chown -R *", "effect": "ask" },
        { "action": "shell", "resource": "chattr *", "effect": "deny" },

        { "action": "shell", "resource": "dd *", "effect": "deny" },
        { "action": "shell", "resource": "mkfs*", "effect": "deny" },
        { "action": "shell", "resource": "fdisk *", "effect": "deny" },
        { "action": "shell", "resource": "parted *", "effect": "deny" },
        { "action": "shell", "resource": "wipefs *", "effect": "deny" },
        { "action": "shell", "resource": "mount *", "effect": "deny" },
        { "action": "shell", "resource": "umount *", "effect": "deny" },
        { "action": "shell", "resource": "cryptsetup *", "effect": "deny" },
        { "action": "shell", "resource": "* > /dev/sd*", "effect": "deny" },
        { "action": "shell", "resource": "* > /dev/nvme*", "effect": "deny" },
        { "action": "shell", "resource": "* > /dev/disk*", "effect": "deny" },

        { "action": "shell", "resource": "shutdown*", "effect": "deny" },
        { "action": "shell", "resource": "reboot*", "effect": "deny" },
        { "action": "shell", "resource": "poweroff*", "effect": "deny" },
        { "action": "shell", "resource": "halt*", "effect": "deny" },
        { "action": "shell", "resource": "init 0", "effect": "deny" },
        { "action": "shell", "resource": "init 6", "effect": "deny" },
        {
            "action": "shell",
            "resource": "systemctl poweroff*",
            "effect": "deny",
        },
        {
            "action": "shell",
            "resource": "systemctl reboot*",
            "effect": "deny",
        },
        { "action": "shell", "resource": "systemctl stop *", "effect": "ask" },
        {
            "action": "shell",
            "resource": "systemctl disable *",
            "effect": "ask",
        },
        { "action": "shell", "resource": "systemctl mask *", "effect": "deny" },

        { "action": "shell", "resource": "kill -9 -1", "effect": "deny" },
        { "action": "shell", "resource": "killall *", "effect": "ask" },
        { "action": "shell", "resource": "pkill *", "effect": "ask" },

        { "action": "shell", "resource": ":(){ :|:& };:", "effect": "deny" },
        { "action": "shell", "resource": "* | sh", "effect": "deny" },
        { "action": "shell", "resource": "* | bash", "effect": "deny" },
        { "action": "shell", "resource": "* | zsh", "effect": "deny" },
        { "action": "shell", "resource": "* | sudo *", "effect": "deny" },
        { "action": "shell", "resource": "curl * | *", "effect": "deny" },
        { "action": "shell", "resource": "wget * | *", "effect": "deny" },
        { "action": "shell", "resource": "eval *", "effect": "ask" },

        { "action": "shell", "resource": "git push --force*", "effect": "ask" },
        { "action": "shell", "resource": "git push -f*", "effect": "ask" },
        {
            "action": "shell",
            "resource": "git push * --force*",
            "effect": "ask",
        },
        { "action": "shell", "resource": "git push * -f", "effect": "ask" },
        { "action": "shell", "resource": "git reset --hard*", "effect": "ask" },
        { "action": "shell", "resource": "git clean -*f*", "effect": "ask" },
        { "action": "shell", "resource": "git checkout -- .", "effect": "ask" },
        { "action": "shell", "resource": "git branch -D *", "effect": "ask" },
        {
            "action": "shell",
            "resource": "git push * --delete*",
            "effect": "ask",
        },
        {
            "action": "shell",
            "resource": "git filter-branch*",
            "effect": "deny",
        },

        { "action": "shell", "resource": "pacman -R*", "effect": "ask" },
        { "action": "shell", "resource": "pacman -S*", "effect": "ask" },
        { "action": "shell", "resource": "yay *", "effect": "ask" },
        { "action": "shell", "resource": "paru *", "effect": "ask" },
        { "action": "shell", "resource": "apt remove*", "effect": "ask" },
        { "action": "shell", "resource": "apt purge*", "effect": "ask" },
        { "action": "shell", "resource": "apt install*", "effect": "ask" },
        { "action": "shell", "resource": "npm publish*", "effect": "ask" },
        { "action": "shell", "resource": "pip install*", "effect": "ask" },
        { "action": "shell", "resource": "pipx install*", "effect": "ask" },
        {
            "action": "shell",
            "resource": "docker system prune*",
            "effect": "ask",
        },
        { "action": "shell", "resource": "docker rm*", "effect": "ask" },
        { "action": "shell", "resource": "docker rmi*", "effect": "ask" },
        { "action": "shell", "resource": "docker volume rm*", "effect": "ask" },
        {
            "action": "shell",
            "resource": "docker run *--privileged*",
            "effect": "deny",
        },
        {
            "action": "shell",
            "resource": "docker run *-v /:*",
            "effect": "deny",
        },

        { "action": "shell", "resource": "crontab -r*", "effect": "deny" },
        { "action": "shell", "resource": "passwd*", "effect": "deny" },
        { "action": "shell", "resource": "useradd*", "effect": "deny" },
        { "action": "shell", "resource": "userdel*", "effect": "deny" },
        { "action": "shell", "resource": "usermod*", "effect": "deny" },
        { "action": "shell", "resource": "visudo*", "effect": "deny" },
        { "action": "shell", "resource": "iptables*", "effect": "ask" },
        { "action": "shell", "resource": "nft *", "effect": "ask" },
        { "action": "shell", "resource": "ufw *", "effect": "ask" },

        { "action": "shell", "resource": "ssh *", "effect": "ask" },
        { "action": "shell", "resource": "scp *", "effect": "ask" },
        { "action": "shell", "resource": "rsync *--delete*", "effect": "ask" },
        { "action": "shell", "resource": "nc *", "effect": "ask" },
        { "action": "shell", "resource": "ncat *", "effect": "ask" },

        { "action": "shell", "resource": "cat *id_rsa*", "effect": "deny" },
        { "action": "shell", "resource": "cat *id_ed25519*", "effect": "deny" },
        { "action": "shell", "resource": "cat ~/.ssh/*", "effect": "deny" },
        { "action": "shell", "resource": "cat *.pem", "effect": "deny" },
        { "action": "shell", "resource": "cat *.env", "effect": "ask" },
        { "action": "shell", "resource": "cat /etc/shadow*", "effect": "deny" },
        { "action": "shell", "resource": "printenv*", "effect": "ask" },
        { "action": "shell", "resource": "env", "effect": "ask" },

        { "action": "shell", "resource": "mv * /dev/null", "effect": "deny" },
        { "action": "shell", "resource": "> /etc/*", "effect": "deny" },
        { "action": "shell", "resource": "* > /etc/*", "effect": "deny" },
        { "action": "shell", "resource": "* >> /etc/*", "effect": "deny" },
        { "action": "shell", "resource": "* > ~/.bashrc", "effect": "ask" },
        { "action": "shell", "resource": "* > ~/.zshrc", "effect": "ask" },
        { "action": "shell", "resource": "tee /etc/*", "effect": "deny" },

        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "external_directory", "resource": "*", "effect": "ask" },

        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "read", "resource": "*.env.example", "effect": "allow" },
    ],
}
