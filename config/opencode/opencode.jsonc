{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "bash": {
            "*": "allow",

            "rm -rf /*": "deny",
            "rm -rf /": "deny",
            "rm -rf ~*": "deny",
            "rm -rf $HOME*": "deny",
            "rm -rf .": "deny",
            "rm -rf ..": "deny",
            "rm -rf *": "ask",
            "rm -fr *": "ask",
            "rm -r *": "ask",
            "rmdir *": "ask",
            "shred *": "deny",
            "unlink *": "ask",
            "find * -delete*": "ask",
            "find * -exec rm*": "ask",

            "sudo *": "ask",
            "su *": "deny",
            "doas *": "ask",
            "pkexec *": "deny",
            "chmod -R *": "ask",
            "chmod 777 *": "deny",
            "chown -R *": "ask",
            "chattr *": "deny",

            "dd *": "deny",
            "mkfs*": "deny",
            "fdisk *": "deny",
            "parted *": "deny",
            "wipefs *": "deny",
            "mount *": "deny",
            "umount *": "deny",
            "cryptsetup *": "deny",
            "* > /dev/sd*": "deny",
            "* > /dev/nvme*": "deny",
            "* > /dev/disk*": "deny",

            "shutdown*": "deny",
            "reboot*": "deny",
            "poweroff*": "deny",
            "halt*": "deny",
            "init 0": "deny",
            "init 6": "deny",
            "systemctl poweroff*": "deny",
            "systemctl reboot*": "deny",
            "systemctl stop *": "ask",
            "systemctl disable *": "ask",
            "systemctl mask *": "deny",

            "kill -9 -1": "deny",
            "killall *": "ask",
            "pkill *": "ask",

            ":(){ :|:& };:": "deny",
            "* | sh": "deny",
            "* | bash": "deny",
            "* | zsh": "deny",
            "* | sudo *": "deny",
            "curl * | *": "deny",
            "wget * | *": "deny",
            "eval *": "ask",

            "git push --force*": "ask",
            "git push -f*": "ask",
            "git push * --force*": "ask",
            "git push * -f": "ask",
            "git reset --hard*": "ask",
            "git clean -*f*": "ask",
            "git checkout -- .": "ask",
            "git branch -D *": "ask",
            "git push * --delete*": "ask",
            "git filter-branch*": "deny",

            "pacman -R*": "ask",
            "pacman -S*": "ask",
            "yay *": "ask",
            "paru *": "ask",
            "apt remove*": "ask",
            "apt purge*": "ask",
            "apt install*": "ask",
            "npm publish*": "ask",
            "pip install*": "ask",
            "docker system prune*": "ask",
            "docker rm*": "ask",
            "docker rmi*": "ask",
            "docker volume rm*": "ask",
            "docker run *--privileged*": "deny",
            "docker run *-v /:*": "deny",

            "crontab -r*": "deny",
            "passwd*": "deny",
            "useradd*": "deny",
            "userdel*": "deny",
            "usermod*": "deny",
            "visudo*": "deny",
            "iptables*": "ask",
            "nft *": "ask",
            "ufw *": "ask",

            "ssh *": "ask",
            "scp *": "ask",
            "rsync *--delete*": "ask",
            "nc *": "ask",
            "ncat *": "ask",

            "cat *id_rsa*": "deny",
            "cat *id_ed25519*": "deny",
            "cat ~/.ssh/*": "deny",
            "cat *.pem": "deny",
            "cat *.env": "ask",
            "cat /etc/shadow*": "deny",
            "printenv*": "ask",
            "env": "ask",

            "mv * /dev/null": "deny",
            "> /etc/*": "deny",
            "* > /etc/*": "deny",
            "* >> /etc/*": "deny",
            "* > ~/.bashrc": "ask",
            "* > ~/.zshrc": "ask",
            "tee /etc/*": "deny",
        },

        "edit": "allow",
        "webfetch": "allow",
        "external_directory": "ask",
        "doom_loop": "ask",
        "*.env": "deny",
        "*.env.*": "deny",
        "*.env.example": "allow",
    },
}
